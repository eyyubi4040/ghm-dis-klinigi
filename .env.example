# Dokploy > Uygulama > Environment bölümüne girilecek değişkenler

# Yönetici paneli (/admin) parolası — ZORUNLU, güçlü bir parola seçin
ADMIN_PASSWORD=

# Oturum imzalama anahtarı — uzun rastgele bir metin (boş bırakılırsa her yeniden başlatmada oturumlar düşer)
SESSION_SECRET=

# İsteğe bağlı: Google Cloud Storage (admin panelindeki medya yükleme için)
# GCS_BUCKET_NAME=eycodex
# GCS_KEY_JSON={"type":"service_account", ...tek satır JSON...}

# Dockerfile içinde zaten tanımlı (değiştirmeniz gerekmez)
# PORT=3000
# DATA_DIR=/app/data

